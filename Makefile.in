DESTDIR =
prefix = @prefix@
exec_prefix = @exec_prefix@
bindir = @bindir@
CC = @CC@
CXX = @CXX@

TARGET = recdvb4k
TARGET2 = recpt1ctl4k
TARGET3 = chkdvbsignal4k
TARGET4 = tssplitter_lite4k
TARGETS = $(TARGET) $(TARGET2) $(TARGET3) $(TARGET4)
RELEASE_VERSION = "1.2.1.1"

CPPFLAGS = -Wall -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 @B61_CPPFLAGS@
CFLAGS   = -O2 -g -pthread
CXXFLAGS = -O2 -g -pthread -std=c++20 -Wall @B61_CPPFLAGS@

LIBS     = @LIBS@
LIBS2    = -lm
LIBS3    = -lpthread -lm
LIBS4    =
B61_LIBS = @B61_LIBS@
LDFLAGS  =

B61_OBJS = @B61_OBJS@
B61_TEST_TARGET = @B61_TEST_TARGET@
REC_OBJS = recpt1.o decoder.o mkpath.o tssplitter_lite.o recpt1core.o
OBJS  = $(REC_OBJS) $(B61_OBJS)
OBJS2 = recpt1ctl.o recpt1core.o
OBJS3 = checksignal.o recpt1core.o
OBJS4 = tssplitter_lite.o tsmain.o
OBJALL = $(OBJS) $(OBJS2) $(OBJS3) $(OBJS4) acas_test.o
DEPEND = .deps

ifdef EXTRA_SID
CPPFLAGS += -DENABLE_EXTRA_SID
endif

all: $(TARGETS)

clean:
	rm -f $(OBJALL) $(TARGETS) $(B61_TEST_TARGET) $(DEPEND) version.h

distclean: clean
	rm -f Makefile config.h config.log config.status

maintainer-clean: distclean
	rm -fr configure config.h.in aclocal.m4 autom4te.cache *~

$(TARGET): $(OBJS)
	$(CXX) $(LDFLAGS) -o $@ $(OBJS) $(LIBS) $(B61_LIBS)

$(TARGET2): $(OBJS2)
	$(CC) $(LDFLAGS) -o $@ $(OBJS2) $(LIBS2)

$(TARGET3): $(OBJS3)
	$(CC) $(LDFLAGS) -o $@ $(OBJS3) $(LIBS3)

$(TARGET4): $(OBJS4)
	$(CC) $(LDFLAGS) -o $@ $(OBJS4) $(LIBS4)

acas_passthrough.o: acas/passthrough.cpp acas/passthrough.h acas/state.h acas/sections.h
	$(CXX) $(CXXFLAGS) -c $< -o $@

acas_state.o: acas/state.cpp acas/state.h acas/card.h acas/sections.h acas/crypto/aes.h
	$(CXX) $(CXXFLAGS) -c $< -o $@

acas_card.o: acas/card.cpp acas/card.h acas/proxy/client.h acas/crypto/sha256.h
	$(CXX) $(CXXFLAGS) -c $< -o $@

acas_sections.o: acas/sections.cpp acas/sections.h
	$(CXX) $(CXXFLAGS) -c $< -o $@

acas_response.o: acas/response.cpp acas/response.h
	$(CXX) $(CXXFLAGS) -c $< -o $@

acas_aes.o: acas/crypto/aes.cpp acas/crypto/aes.h
	$(CXX) $(CXXFLAGS) -c $< -o $@

acas_cas_proxy_client.o: acas/proxy/client.cpp acas/proxy/client.h acas/proxy/protocol.h
	$(CXX) $(CXXFLAGS) -c $< -o $@

acas_test.o: acas/tests/acas_test.cpp acas/passthrough.h acas/state.h acas/sections.h acas/response.h acas/card.h acas/crypto/aes.h
	$(CXX) $(CXXFLAGS) -c $< -o $@

acas_test: acas_test.o $(B61_OBJS)
	$(CXX) $(LDFLAGS) -o $@ acas_test.o $(B61_OBJS) $(LIBS) $(B61_LIBS)

check: $(B61_TEST_TARGET)
	@if test -n "$(B61_TEST_TARGET)"; then ./$(B61_TEST_TARGET); else echo "B61 tests skipped (configure with --enable-b61)"; fi

$(DEPEND): version.h
	$(CC) -MM $(REC_OBJS:.o=.c) $(OBJS2:.o=.c) $(CPPFLAGS) > $@

version.h:
	revh=`hg parents --template 'const char *version = "r{rev}:{node|short} ({date|shortdate})";\n' 2>/dev/null`; \
	if [ -n "$$revh" ] ; then \
		echo "$$revh" > $@; \
	else \
		echo "const char *version = \"$(RELEASE_VERSION)\";" > $@; \
	fi

install: $(TARGETS)
	install -m 755 $(TARGETS) $(DESTDIR)$(bindir)

ifeq ($(filter check clean distclean maintainer-clean,$(MAKECMDGOALS)),)
-include .deps
endif
